# --- Search Engine Verification (server-only — never sent to the browser) -----
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Google Search Console verification token
# Get from: search.google.com/search-console ? Add property ? HTML tag method
GOOGLE_SITE_VERIFICATION=your_google_verification_code_here

# Bing Webmaster Tools verification token
# Get from: bing.com/webmasters ? Add site ? HTML meta tag method
BING_SITE_VERIFICATION=your_bing_msvalidate_code_here
